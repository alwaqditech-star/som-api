# Server (Railway يضبط PORT تلقائياً)
PORT=3000
NODE_ENV=production

# PostgreSQL — Railway
# عند النشر على Railway: اربط خدمة Postgres — الاسم الافتراضي railway
# DATABASE_URL يُحقَن تلقائياً من Railway — أو استخدم المتغيرات التالية:
DB_HOST=your-host.proxy.rlwy.net
DB_PORT=37330
DB_USERNAME=postgres
DB_PASSWORD=your-railway-password
DB_DATABASE=railway
DB_SSL=true

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Auction settings
AUCTION_BID_EXTENSION_SECONDS=120
AUCTION_MIN_DEPOSIT_PERCENT=5

# CORS (Flutter web/mobile)
CORS_ORIGIN=*

# Firebase Google Sign-In — على Railway استخدم المتغيرات (بدون ملف):
FIREBASE_PROJECT_ID=som-app-db20a
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@som-app-db20a.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
